# Copy to .env.local for local development, or add these in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values. (.env* files are gitignored, except this example.)

# --- Cloud data: Upstash Redis (required in production) ---
# Easiest: Vercel > Storage / Marketplace > Upstash for Redis > connect to this project. It adds these for you.
# (It may name them KV_REST_API_URL / KV_REST_API_TOKEN instead. The app accepts both.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email: Resend (required for real emails) ---
# Create an API key at resend.com. Without it, codes appear in an on-screen "prototype inbox" (dev only).
RESEND_API_KEY=
# Optional. Until you verify a domain at Resend, keep the default test sender, which can ONLY email
# the address you signed up to Resend with. Verify a domain to email anyone, then e.g. "MOSAIC <no-reply@yourdomain.com>".
EMAIL_FROM=MOSAIC <onboarding@resend.dev>

# --- Reset button protection (strongly recommended once the link is public) ---
# If set, "Reset all data", "Load demo" and ?reset=1 ask for this password.
RESET_PASSWORD=
